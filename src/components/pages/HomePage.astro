---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../Hero.astro';
import TourCard from '../TourCard.astro';
import PostCard from '../PostCard.astro';
import TopoDivider from '../TopoDivider.astro';
import { getToursByLocale, getPostsByLocale, entrySlug } from '../../lib/content';
import { localizePath, t, type Locale } from '../../i18n';
import { organizationJsonLd } from '../../lib/jsonld';
import { videoSeries } from '../../lib/courses';

interface Props { locale: Locale }
const { locale } = Astro.props;

const tours = (await getToursByLocale(locale)).slice(0, 3);
const posts = (await getPostsByLocale(locale)).slice(0, 3);
const videos = videoSeries[locale];

const site = Astro.site!;
const jsonLd = organizationJsonLd(site.toString());
---

<BaseLayout
  title={`${t(locale, 'site.name')} · ${t(locale, 'site.tagline')}`}
  description={t(locale, 'site.description')}
  locale={locale}
  headerVariant="ink"
  jsonLd={jsonLd}
>

  <Hero
    locale={locale}
    primaryCtaHref={localizePath(locale, '/tours')}
    secondaryCtaHref={localizePath(locale, '/blog')}
    coursesCtaHref={localizePath(locale, '/courses')}
  />

  <section id="tours" class="mx-auto max-w-6xl px-6 pt-10 scroll-mt-20">
    <header class="reveal mb-10 flex items-end justify-between border-b border-[color:var(--color-ink)] pb-4">
      <div>
        <p class="mono-eyebrow">{t(locale, 'home.tours.eyebrow')}</p>
        <h2 class="mt-2 text-4xl md:text-5xl">{t(locale, 'home.tours.title')}</h2>
      </div>
      <a
        href={localizePath(locale, '/tours')}
        class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink)] hover:text-[color:var(--color-flare)]"
      >
        {t(locale, 'home.tours.viewAll')} →
      </a>
    </header>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {tours.map((tour, i) => <TourCard tour={tour} locale={locale} slug={entrySlug(tour)} index={i} />)}
    </div>
  </section>

  <TopoDivider />

  <section id="courses" class="relative scroll-mt-20 overflow-hidden bg-[color:var(--color-ink)] text-[color:var(--color-chalk)]">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 w-1/2 bg-[linear-gradient(135deg,transparent_0%,transparent_55%,rgba(238,74,34,0.18)_55%,rgba(238,74,34,0.18)_60%,transparent_60%)]"
    ></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[1.1fr_1fr] md:items-end">
      <div class="reveal">
        <p class="mono-eyebrow mono-eyebrow--chalk">{t(locale, 'home.courses.eyebrow')}</p>
        <h2 class="mt-4 text-4xl leading-[1.05] md:text-6xl">
          {t(locale, 'home.courses.title')}
        </h2>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-[color:var(--color-line-soft)]">
          {t(locale, 'home.courses.body')}
        </p>
        <a
          href={localizePath(locale, '/courses')}
          class="group mt-8 inline-flex items-center gap-3 bg-[color:var(--color-flare)] px-6 py-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink)] transition-transform hover:-translate-y-[1px] hover:shadow-[4px_4px_0_0_var(--color-chalk)]"
        >
          <span>{t(locale, 'home.courses.cta')}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
      <ol class="reveal grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          [
            { k: 'home.courses.list.topRope', href: '/courses#top-rope' },
            { k: 'home.courses.list.lead', href: '/courses#lead' },
            { k: 'home.courses.list.multiPitch', href: '/courses#multi-pitch' },
            { k: 'home.courses.list.trad', href: '/courses#trad' },
          ].map((item, i) => (
            <li>
              <a
                href={localizePath(locale, item.href)}
                class="group flex items-baseline gap-4 border border-[color:var(--color-slate-2)] px-4 py-3 transition-colors hover:border-[color:var(--color-flare)]"
              >
                <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)] group-hover:text-[color:var(--color-flare)]">
                  No. {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-display text-lg text-[color:var(--color-chalk)] group-hover:text-[color:var(--color-flare)]">
                  {t(locale, item.k as any)}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <TopoDivider />

  <section id="journal" class="mx-auto max-w-6xl px-6 scroll-mt-20">
    <header class="reveal mb-4 border-b border-[color:var(--color-ink)] pb-4">
      <p class="mono-eyebrow">{t(locale, 'home.posts.eyebrow')}</p>
      <div class="mt-2 flex items-end justify-between">
        <h2 class="text-4xl md:text-5xl">{t(locale, 'home.posts.title')}</h2>
        <a
          href={localizePath(locale, '/blog')}
          class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink)] hover:text-[color:var(--color-flare)]"
        >
          {t(locale, 'home.posts.viewAll')} →
        </a>
      </div>
    </header>
    <div>
      {posts.map((post, i) => <PostCard post={post} locale={locale} slug={entrySlug(post)} index={i} />)}
    </div>
  </section>

  <TopoDivider />

  <section id="video" class="mx-auto max-w-6xl px-6 scroll-mt-20">
    <header class="reveal mb-10 flex items-end justify-between border-b border-[color:var(--color-ink)] pb-4">
      <div>
        <p class="mono-eyebrow">{t(locale, 'home.video.eyebrow')}</p>
        <h2 class="mt-2 text-4xl md:text-5xl">{t(locale, 'home.video.title')}</h2>
      </div>
      <a
        href={`${localizePath(locale, '/courses')}#video`}
        class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink)] hover:text-[color:var(--color-flare)]"
      >
        {t(locale, 'home.video.cta')} →
      </a>
    </header>
    <p class="reveal mb-10 max-w-2xl text-base leading-relaxed text-[color:var(--color-slate)]">
      {t(locale, 'home.video.body')}
    </p>
    <ol class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        videos.map((series, i) => (
          <li>
            <a
              href={`${localizePath(locale, '/courses')}#video`}
              class="group flex h-full flex-col justify-between border border-[color:var(--color-line)] bg-[color:var(--color-chalk)] p-4 transition-colors hover:border-[color:var(--color-ink)]"
            >
              <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                {t(locale, 'courses.video.chapter')} {String(i + 1).padStart(2, '0')} · {series.tag}
              </span>
              <span class="mt-6 block font-display text-xl leading-tight text-[color:var(--color-ink)] transition-colors group-hover:text-[color:var(--color-flare)]">
                {series.title}
              </span>
              <span class="mt-1 block font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                {series.episodes.length} {t(locale, 'courses.video.episodes')}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <TopoDivider />

  <section class="reveal mx-auto max-w-4xl px-6 pb-16">
    <p class="mono-eyebrow">{t(locale, 'home.about.eyebrow')}</p>
    <h2 class="mt-3 max-w-3xl text-4xl leading-[1.05] md:text-6xl">
      {t(locale, 'home.about.title')}
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-slate)]">
      {t(locale, 'home.about.body')}
    </p>
  </section>
</BaseLayout>
