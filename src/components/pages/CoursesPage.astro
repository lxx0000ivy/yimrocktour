---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, type Locale } from '../../i18n';
import { courses, instructor, fieldRecord, videoSeries } from '../../lib/courses';

interface Props { locale: Locale }
const { locale } = Astro.props;

const list = courses[locale];
const coach = instructor[locale];
const record = fieldRecord[locale];
const videos = videoSeries[locale];

const priceFmt = new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'en-US');
---

<BaseLayout
  title={`${t(locale, 'courses.title')} · ${t(locale, 'site.name')}`}
  description={t(locale, 'courses.subtitle')}
  locale={locale}
>
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-16">
    <p class="mono-eyebrow">{t(locale, 'courses.eyebrow')}</p>
    <div class="mt-4 flex flex-col gap-6 border-b border-[color:var(--color-ink)] pb-10 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-5xl leading-[1.02] md:text-7xl">{t(locale, 'courses.title')}</h1>
        <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.28em] text-[color:var(--color-flare)]">
          {t(locale, 'courses.tagline')}
        </p>
      </div>
      <p class="max-w-md text-base leading-relaxed text-[color:var(--color-slate)]">
        {t(locale, 'courses.subtitle')}
      </p>
    </div>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        list.map((course, i) => (
          <li>
            <a
              href={`#${course.id}`}
              class="group flex h-full flex-col justify-between border border-[color:var(--color-line)] bg-[color:var(--color-chalk)] p-4 transition-colors hover:border-[color:var(--color-ink)]"
            >
              <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                No. {String(i + 1).padStart(2, '0')}
              </span>
              <span class="mt-6 block font-display text-xl leading-tight text-[color:var(--color-ink)] transition-colors group-hover:text-[color:var(--color-flare)]">
                {course.name}
              </span>
              <span class="mt-1 block font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                {course.nameEn}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-[color:var(--color-line)] bg-[color:var(--color-stone)]">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-[1fr_2fr]">
      <div>
        <p class="mono-eyebrow">{t(locale, 'courses.instructor.eyebrow')}</p>
        <h2 class="mt-4 font-display text-4xl leading-tight text-[color:var(--color-ink)]">
          {coach.name}
        </h2>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
          {t(locale, 'courses.instructor.subtitle')}
        </p>
      </div>
      <ul class="space-y-3 text-base leading-relaxed text-[color:var(--color-ink)]">
        {
          coach.bullets.map((b) => (
            <li class="flex items-start gap-3 border-b border-dashed border-[color:var(--color-line)] pb-3 last:border-b-0 last:pb-0">
              <span aria-hidden="true" class="mt-1 inline-block h-2 w-2 bg-[color:var(--color-flare)]"></span>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex flex-col gap-16">
      {
        list.map((course, idx) => (
          <article id={course.id} class="scroll-mt-20">
            <header class="flex flex-col gap-3 border-b border-[color:var(--color-ink)] pb-6 md:flex-row md:items-end md:justify-between">
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                  No. {String(idx + 1).padStart(2, '0')} · {course.nameEn}
                </p>
                <h2 class="mt-3 font-display text-4xl leading-tight text-[color:var(--color-ink)] md:text-5xl">
                  {course.name}
                </h2>
                <p class="mt-3 max-w-xl text-base text-[color:var(--color-slate)]">
                  {course.tagline}
                </p>
              </div>
              <div class="flex flex-col items-start gap-1 md:items-end">
                {course.prices.map((p) => (
                  <div class="flex items-baseline gap-2">
                    <span class="font-display text-3xl text-[color:var(--color-ink)]">
                      ¥{priceFmt.format(p.amountCNY)}
                    </span>
                    <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                      / {p.unit}
                    </span>
                  </div>
                ))}
              </div>
            </header>

            <div class="mt-8 grid gap-10 md:grid-cols-[2fr_1fr]">
              <div>
                <p class="mono-eyebrow">{t(locale, 'courses.curriculum')}</p>
                <div class="mt-4 flex flex-col gap-6">
                  {course.curriculum.map((day) => (
                    <div class="border-l-2 border-[color:var(--color-flare)] pl-5">
                      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-ink)]">
                        {day.label}
                      </p>
                      <ol class="mt-3 list-decimal space-y-1 pl-4 text-sm leading-relaxed text-[color:var(--color-slate)] marker:font-mono marker:text-[color:var(--color-slate-2)]">
                        {day.items.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </div>

              <aside class="flex flex-col gap-6">
                <div>
                  <p class="mono-eyebrow">{t(locale, 'courses.prereq')}</p>
                  <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-slate)]">
                    {course.prereq}
                  </p>
                </div>
                <div>
                  <p class="mono-eyebrow">{t(locale, 'courses.price')}</p>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[color:var(--color-slate)]">
                    {course.prices.map((p) => (
                      <li>
                        <span class="font-display text-base text-[color:var(--color-ink)]">
                          ¥{priceFmt.format(p.amountCNY)}
                        </span>
                        <span> / {p.unit}</span>
                        {p.note && (
                          <span class="block text-[color:var(--color-slate-2)]">{p.note}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
                {course.ratio && (
                  <div>
                    <p class="mono-eyebrow">{t(locale, 'courses.ratio')}</p>
                    <p class="mt-3 font-display text-xl text-[color:var(--color-ink)]">
                      {course.ratio}
                    </p>
                  </div>
                )}
                {course.perks && course.perks.length > 0 && (
                  <ul class="space-y-1 text-xs leading-relaxed text-[color:var(--color-slate-2)]">
                    {course.perks.map((p) => (
                      <li>· {p}</li>
                    ))}
                  </ul>
                )}
              </aside>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-[color:var(--color-line)] bg-[color:var(--color-stone)]">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="mono-eyebrow">{t(locale, 'courses.cv.eyebrow')}</p>
      <h2 class="mt-4 max-w-2xl font-display text-4xl leading-tight text-[color:var(--color-ink)] md:text-5xl">
        {t(locale, 'courses.cv.title')}
      </h2>
      <ol class="mt-10 grid gap-x-10 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          record.map((r, i) => (
            <li class="flex items-baseline gap-4 border-b border-dashed border-[color:var(--color-line)] py-3">
              <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <p class="font-display text-lg text-[color:var(--color-ink)]">{r.place}</p>
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                  {r.note}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="video" class="relative overflow-hidden bg-[color:var(--color-ink)] text-[color:var(--color-chalk)]">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 left-0 w-1/2 bg-[linear-gradient(315deg,transparent_0%,transparent_55%,rgba(238,74,34,0.14)_55%,rgba(238,74,34,0.14)_60%,transparent_60%)]"
    ></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-col gap-6 border-b border-[color:var(--color-slate-2)] pb-10 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mono-eyebrow mono-eyebrow--chalk">{t(locale, 'courses.video.eyebrow')}</p>
          <h2 class="mt-4 max-w-2xl text-4xl leading-[1.05] md:text-5xl">
            {t(locale, 'courses.video.title')}
          </h2>
        </div>
        <p class="max-w-md text-base leading-relaxed text-[color:var(--color-line-soft)]">
          {t(locale, 'courses.video.subtitle')}
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          videos.map((series, idx) => {
            const total = series.episodes.length;
            const firstEp = series.episodes[0];
            const hasVideo = !!firstEp?.src;
            return (
              <article class="flex flex-col border border-[color:var(--color-slate-2)] bg-[color:var(--color-slate)]/40 p-5">
                <div class="relative aspect-[16/10] overflow-hidden border border-[color:var(--color-slate-2)] bg-[color:var(--color-ink)]">
                  {hasVideo ? (
                    <video
                      class="h-full w-full object-cover"
                      controls
                      preload="metadata"
                      poster={firstEp?.poster}
                      src={firstEp?.src}
                    />
                  ) : (
                    <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-[color:var(--color-slate-2)]">
                      <span class="font-mono text-[10px] uppercase tracking-[0.28em]">
                        {t(locale, 'courses.video.pending')}
                      </span>
                      <span class="font-display text-3xl text-[color:var(--color-chalk)]/40">▸</span>
                    </div>
                  )}
                  <span class="absolute left-3 top-3 border border-[color:var(--color-chalk)]/40 bg-[color:var(--color-ink)]/80 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-chalk)]">
                    {t(locale, 'courses.video.chapter')} {String(idx + 1).padStart(2, '0')}
                  </span>
                </div>

                <div class="mt-5 flex items-center justify-between gap-3">
                  <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-flare)]">
                    {series.tag}
                  </span>
                  <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                    {total} {t(locale, 'courses.video.episodes')}
                  </span>
                </div>

                <h3 class="mt-3 font-display text-2xl leading-tight text-[color:var(--color-chalk)]">
                  {series.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-line-soft)]">
                  {series.summary}
                </p>

                <ol class="mt-5 space-y-2 border-t border-[color:var(--color-slate-2)] pt-4">
                  {series.episodes.map((ep, i) => (
                    <li class="flex items-baseline justify-between gap-4 text-sm text-[color:var(--color-chalk)]">
                      <span class="flex items-baseline gap-3">
                        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{ep.title}</span>
                      </span>
                      {ep.duration && (
                        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)]">
                          {ep.duration}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </article>
            );
          })
        }
      </div>

      <div class="mt-12 flex items-center justify-center">
        <a
          href={`mailto:hello@yimrocktour.com?subject=${encodeURIComponent(t(locale, 'courses.video.cta'))}`}
          class="group inline-flex items-center gap-3 border border-[color:var(--color-chalk)] px-6 py-3 font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-chalk)] transition-colors hover:bg-[color:var(--color-chalk)] hover:text-[color:var(--color-ink)]"
        >
          <span>{t(locale, 'courses.video.cta')}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 text-center">
    <p class="mono-eyebrow justify-center">{t(locale, 'courses.cta.eyebrow')}</p>
    <h2 class="mt-4 font-display text-4xl leading-tight text-[color:var(--color-ink)] md:text-5xl">
      {t(locale, 'courses.cta.title')}
    </h2>
    <p class="mt-6 text-base leading-relaxed text-[color:var(--color-slate)]">
      {t(locale, 'courses.cta.body')}
    </p>
  </section>
</BaseLayout>
