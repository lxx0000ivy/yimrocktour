---
import { Image } from 'astro:assets';
import { localizePath, type Locale } from '../i18n';
import type { CollectionEntry } from 'astro:content';
import GradeTag from './GradeTag.astro';

interface Props {
  tour: CollectionEntry<'tours'>;
  locale: Locale;
  slug: string;
  index?: number;
}
const { tour, locale, slug, index } = Astro.props;
const { title, summary, location, durationDays, difficulty, climbingType, heroImage } = tour.data;
const href = localizePath(locale, `/tours/${slug}`);
const catalogueNo = String((index ?? 0) + 1).padStart(3, '0');
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden border border-[color:var(--color-line)] bg-[color:var(--color-chalk)] transition-shadow hover:shadow-[10px_10px_0_0_var(--color-ink)]"
>
  <div class="relative aspect-[5/4] overflow-hidden bg-[color:var(--color-stone)]">
    <Image
      src={heroImage}
      alt={title}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      class="h-full w-full object-cover grayscale-[0.15] transition-all duration-700 group-hover:scale-[1.04] group-hover:grayscale-0"
    />
    <span
      class="absolute left-3 top-3 border border-[color:var(--color-chalk)]/70 bg-[color:var(--color-ink)]/70 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-chalk)] backdrop-blur"
    >
      No. {catalogueNo}
    </span>
    <span
      class="absolute right-3 top-3"
    >
      <GradeTag locale={locale} style={climbingType} grade={difficulty} duration={durationDays} />
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 border-t border-[color:var(--color-line)] p-5">
    <p class="mono-eyebrow">{location}</p>
    <h3 class="text-2xl leading-tight tracking-tight text-[color:var(--color-ink)] transition-colors group-hover:text-[color:var(--color-flare)]">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-[color:var(--color-slate)]">{summary}</p>
    <span class="mt-2 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.22em] text-[color:var(--color-slate-2)] group-hover:text-[color:var(--color-flare)]">
      <span>Read</span>
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
