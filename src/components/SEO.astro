---
import { DEFAULT_LOCALE, LOCALES, localeHtmlLang, switchLocalePath, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** Absolute or root-relative URL of the OG image; falls back to the locale-aware default. */
  image?: string;
  /** Override for canonical URL; defaults to Astro.url */
  canonical?: URL | string;
  /** JSON-LD structured data object (single or array). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** For article-type pages */
  publishedTime?: Date;
  /** For article-type pages */
  modifiedTime?: Date;
  type?: 'website' | 'article';
  /**
   * Locales that actually have a translation of this page. When set, only
   * those alternates are emitted (prevents 404 hreflang links for posts /
   * tours that aren't published in every locale yet).
   */
  availableLocales?: Locale[];
  /** Extra <link rel="alternate"> entries, e.g. RSS feeds. */
  feedAlternates?: { type: string; href: string; title?: string }[];
}

const defaultOg: Record<Locale, string> = {
  zh: '/og-default-zh.svg',
  en: '/og-default-en.svg',
};

const {
  title,
  description,
  locale,
  image = defaultOg[locale],
  canonical,
  jsonLd,
  publishedTime,
  modifiedTime,
  type = 'website',
  availableLocales,
  feedAlternates = [],
} = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error('Astro.site is not set; configure `site` in astro.config.mjs.');
}

const canonicalUrl = canonical
  ? new URL(canonical.toString(), site)
  : new URL(Astro.url.pathname, site);

const ogImage = new URL(image, site).toString();

// hreflang alternates: only locales that actually have this page.
const emittedLocales = availableLocales ?? [...LOCALES];
const alternates = emittedLocales.map((l) => ({
  hrefLang: localeHtmlLang(l),
  href: new URL(switchLocalePath(Astro.url.pathname, l), site).toString(),
}));
// x-default points at the default locale when it has this page; otherwise
// at the first available locale so bots don't follow a dead link.
const xDefaultLocale: Locale = emittedLocales.includes(DEFAULT_LOCALE)
  ? DEFAULT_LOCALE
  : (emittedLocales[0] ?? DEFAULT_LOCALE);

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl.toString()} />

<!-- hreflang -->
{alternates.map((a) => <link rel="alternate" hreflang={a.hrefLang} href={a.href} />)}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(switchLocalePath(Astro.url.pathname, xDefaultLocale), site).toString()}
/>

<!-- Feed alternates (RSS, etc.) -->
{feedAlternates.map((f) => (
  <link rel="alternate" type={f.type} href={f.href} title={f.title} />
))}

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.toString()} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={localeHtmlLang(locale).replace('-', '_')} />
{
  LOCALES.filter((l) => l !== locale).map((l) => (
    <meta property="og:locale:alternate" content={localeHtmlLang(l).replace('-', '_')} />
  ))
}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- JSON-LD -->
{
  jsonLdArray.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}
